# ----------------------------------------------------------------------
# Host Africa / cPanel Apache Configuration
# ----------------------------------------------------------------------

# Disable Directory Browsing
Options -Indexes

# Default Charset
AddDefaultCharset UTF-8

# MIME Types for Modern Web Assets
<IfModule mod_mime.c>
  AddType text/html .html
  AddType text/css .css
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType font/woff .woff
  AddType font/woff2 .woff2
</IfModule>

# SPA URL Routing (React)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # If requested resource is an existing file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise, route to index.html
  RewriteRule . index.html [L]
</IfModule>

# Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript image/svg+xml
</IfModule>
